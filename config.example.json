{
    "cloudflare_accounts": [
        {
            "zones": [
                {
                    "name": "example.tld",
                    "zone_id": "your-zone-id"
                },
                {
                    "name": "example2.tld",
                    "zone_id": "your-other-zone-id"
                }
            ],
            "api_token": "your-api-token",
            "excluded_records": [
                "home.example.tld",
                "test.example2.tld"
            ]
        },
        {
            "zones": [
                {
                    "name": "example3.tld",
                    "zone_id": "your-third-zone-id"
                }
            ],
            "api_token": "your-other-api-token",
            "excluded_records": []
        }
    ],
    "ip_provider_url": "https://api.ipify.org",
    "request_timeout_seconds": 10,
    "dns_record_ttl_seconds": 120,
    "log_file": "cloudflare_updater.log",
    "metrics_file": "/var/lib/prometheus/node-exporter/cloudflare_updater.prom"
}
